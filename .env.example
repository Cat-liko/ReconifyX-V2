# ReconifyX 配置示例。复制为 .env 后按需填写。
#
# 完整清单(每一项都有中文注释说明为什么存在)见 app/core/config.py。
# 所有项都可以不填 —— 默认值就是"本机单人使用"的安全配置。

# ==================== 服务运行 ====================
# 只监听回环。改成 0.0.0.0 之前请先设置 API_KEY,否则同网段任何人都能拿它扫任意域名。
# HOST=127.0.0.1
# PORT=8000
# 非空则所有扫描类端点都要求请求头 X-API-Key: <值>。留空 = 不鉴权。
# API_KEY=
# 每 IP 每分钟允许的 API 请求数(令牌桶,防误用而非安全边界)。
# RATE_LIMIT_PER_MINUTE=240

# ==================== 被动数据源 ====================
# CertSpotter 证书透明度(可选,免费注册 https://sslmate.com/certspotter/ 提升匿名限额)
# 留空 = 走匿名配额(仍可用,只是限额低)。
# 注意:不要保留任何占位符字符串。填一个假 token 会让 CertSpotter 返回 401,
# 该骨干源被判失败,进而把整次扫描标记成 degraded。
CERTSPOTTER_TOKEN=

# FOFA 第三方中转站密码(增强源:唯一能带出 IP+端口+指纹)。留空则 FOFA 源自动禁用。
FOFA_PASSWORD=

# ==================== 扫描行为(常用项) ====================
# 单目标探活最多读取的响应体字节数,超出立即断开(默认 64 KiB)
# PROBE_READ_MAX_BYTES=65536
# 单目标探活的整体墙钟上限,防"慢速滴水"占住并发槽位(默认 12s)
# PROBE_OVERALL_TIMEOUT_SECONDS=12.0
# 单个被动数据源的响应体上限,超出即判该源失败(默认 32 MiB)
# SOURCE_MAX_BYTES=33554432
# TLS 证书情报开关与成本上限(一次握手 ≈ 一次额外 TCP+TLS)
# PROBE_TLS_ENABLED=true
# PROBE_TLS_MAX_TARGETS=200
# 企业代理 / 自建 PKI 场景可指定 CA 包;留空时优先用 certifi
# TLS_CA_BUNDLE=

# ==================== 输出与历史 ====================
# 结果 JSON 落盘目录
# RESULT_DIR=res
# 扫描历史(SQLite),用于"与上一次对比"。关掉就没有 diff。
# HISTORY_ENABLED=true
# HISTORY_DB_PATH=data/reconifyx.db
